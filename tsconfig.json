{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "app",
    "components",
    "config",
    "hooks",
    "lib",
    "stores",
    "shared"
  ],
  "exclude": [
    "node_modules",
    "legacy",
    "dist"
  ]
}
