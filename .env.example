# Supabase project (Settings → API). Both values are safe to ship to the browser:
# row level security in supabase/migrations protects each user's data.
# Leave unset to run in guest mode, with data kept in the visitor's browser.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site, used when building share links. Optional in the browser.
EXPO_PUBLIC_SITE_URL=
