{
  "expo": {
    "name": "ANIMA",
    "slug": "anima",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "anima",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.animapet.app",
      "infoPlist": {},
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.animapet.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0F"
      },
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "ANIMA — Pet Longevity Score & Food Ratings",
      "shortName": "ANIMA",
      "description": "A free, evidence-based Longevity Score for your dog or cat, and honest ratings for the food you feed.",
      "themeColor": "#0A0A0F",
      "backgroundColor": "#0A0A0F",
      "lang": "en"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font"
    ]
  }
}
